# Plantilla de variables de entorno. Solo nombres, nunca valores reales.
# En local: copiar a .env.local y rellenar.
# En Vercel: cargarlas en Project Settings -> Environment Variables.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer al cliente ni pegar en un chat.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (generacion de insights)
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Webhook de booking. Solo servidor.
BOOKING_WEBHOOK_SECRET=

# Umbrales de regeneracion (opcionales, default 20)
INSIGHTS_MIN_NEW_RECORDS=20
HERRAMIENTAS_MIN_NEW_RECORDS=20
